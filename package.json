{
  "name": "worldviewnews",
  "version": "0.1.0",
  "description": "Unified open-source intelligence platform — World Monitor + Crucix merged",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node --env-file=.env --import tsx src/index.ts",
